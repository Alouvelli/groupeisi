		        <script>
            window.odometerOptions = {
                selector: '.odometer.id-06f5eb3',
                format: ''
            };
            jQuery(document).ready(function ($) {
                var delay = 0;
                var number = 2;
                var format = "";
                setTimeout(function () {
                    $(".odometer.id-06f5eb3").each(function () {
                        var countNumber = number;
                        countNumber = countNumber.toString();
                        var digits = countNumber.length;
                        var zeros = "0".repeat(digits);
                        $(this).html(zeros);

                        this.od = new Odometer({
                            el: this,
                            value: parseInt(zeros),
                            format: format,
                            theme: 'default'
                        });
                    });

                    $('.odometer.id-06f5eb3').appear(function () {
                        $(this).each(function () {
                            this.od.update(number);
                        });
                    });
                }, delay);
            });
        </script>
