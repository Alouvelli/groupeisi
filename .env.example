# ---------------------------------------------------------------------------
# Groupe ISI - Variables d'environnement (copier vers .env)
# ---------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Groupe ISI"

# --- Base de données (Docker: docker compose up -d) -------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=groupeisi
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/groupeisi?schema=public"

# --- Redis / BullMQ ---------------------------------------------------------
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"
QUEUE_PREFIX=groupeisi

# --- PgAdmin ----------------------------------------------------------------
PGADMIN_EMAIL=admin@groupeisi.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# --- Authentification admin -------------------------------------------------
# Clé de signature des sessions (32+ caractères aléatoires)
AUTH_SECRET="changez-moi-avec-une-longue-chaine-aleatoire-de-32-caracteres-minimum"
# Compte admin créé par le seed
ADMIN_EMAIL=admin@groupeisi.com
ADMIN_PASSWORD=Admin@2026!

# --- Emails (Resend) --------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Groupe ISI <no-reply@groupeisi.com>"
ADMIN_NOTIFICATION_EMAIL=admissions@groupeisi.com

# --- ERP / CRM (valeurs par défaut, modifiables dans /admin/settings) -------
ERP_BASE_URL=
ERP_API_KEY=
ERP_API_SECRET=
ERP_WEBHOOK_SECRET=
ERP_TIMEOUT_MS=15000

# --- Divers -----------------------------------------------------------------
# Jeton pour déclencher /api/cron/* (nettoyage, relances)
CRON_SECRET=

# Chatbot institutionnel : sans cette clé, l'assistant répond en mode documentaire
# (il restitue les passages trouvés au lieu de les faire rédiger par le modèle).
ANTHROPIC_API_KEY=
